SHOWROOM_EMAIL=you@example.com
SHOWROOM_PASSWORD=change-me
SHOWROOM_LOGIN_URL=https://www.showroomprive.com/
SHOWROOM_CATALOG_URL=https://www.showroomprive.com/
SHOWROOM_MAX_SALES_PER_SCAN=3
SHOWROOM_MAX_PAGES_PER_SALE=5

DATABASE_URL=postgresql+psycopg2://showroom:showroom@localhost:55432/showroom

SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#deals

SCAN_INTERVAL_SECONDS=3600
MIN_REAL_DISCOUNT_PERCENT=40
MAX_SHOWROOM_PRICE_EUR=150

PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_STORAGE_STATE_PATH=playwright/.auth/state.json
REQUEST_TIMEOUT_SECONDS=15

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
CRON_AUTOSTART=false

# AI providers (leave empty to disable)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
AI_PROVIDER_ORDER=claude,openai,gemini
AI_RESULT_TTL_HOURS=24

# Web search for Claude provider
TAVILY_API_KEY=
